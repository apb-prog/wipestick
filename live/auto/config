#!/bin/sh
# Debian live-build configuration for wipestick.
# Run via build/build-debian.sh (which syncs src/ and overlay/ first).
set -e

# Graphics: the default entry lets Intel's i915 driver run (native resolution,
# and the display comes back after the suspend used to unfreeze SATA drives).
# amdgpu/radeon/nouveau/xe are blacklisted because without non-free firmware
# they can leave the screen black; those machines use the firmware framebuffer
# instead. The fail-safe entry uses nomodeset for everything.
lb config noauto \
  --mode debian \
  --distribution "${WIPESTICK_SUITE:-trixie}" \
  --architecture amd64 \
  --archive-areas "main" \
  --linux-flavours amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --uefi-secure-boot enable \
  --debian-installer none \
  --memtest none \
  --apt-recommends false \
  --apt-indices false \
  --firmware-binary false \
  --firmware-chroot false \
  --security true \
  --updates true \
  --iso-volume "WIPESTICK" \
  --iso-application "wipestick" \
  --iso-publisher "wipestick project" \
  --bootappend-live "boot=live components quiet loglevel=3 noeject live-config.hostname=wipestick systemd.show_status=false systemd.log_level=crit module_blacklist=amdgpu,radeon,nouveau,xe" \
  --bootappend-live-failsafe "boot=live components quiet loglevel=3 noeject live-config.hostname=wipestick systemd.show_status=false systemd.log_level=crit nomodeset" \
  "${@}"
