#!/usr/bin/env bash
# CI self-test. Runs ONLY when the VM's SMBIOS OEM strings contain
# "wipestick-selftest" (QEMU: -smbios type=11,value=wipestick-selftest),
# and erases ONLY drives whose serial starts with WSTEST. Real hardware
# never matches either condition.
# SPDX-License-Identifier: GPL-3.0-or-later
set -uo pipefail
exec >/dev/ttyS0 2>&1
echo "WIPESTICK-SELFTEST-BEGIN"
fail=0
udevadm settle --timeout=30
sleep 2

list=$(wipestick list)
echo "$list"
if grep -q 'WSBOOT' <<<"$list"; then echo "FAIL: boot disk is listed as erasable"; fail=1; fi

# Suspend/resume check: the SATA unfreeze path suspends real machines, so make
# sure the live system (boot medium, services, display driver) survives it.
echo "display driver: $(wipestick display)"
# The default boot entry must have a real graphics driver (bochs-drm in QEMU),
# otherwise the screen would not come back after the SATA unfreeze suspend.
wipestick display >/dev/null || { echo "FAIL: no graphics driver loaded"; fail=1; }
# Opt-in via a second OEM string: QEMU's UEFI firmware (OVMF) hangs on S3
# resume under emulation, so the harness only requests this for BIOS boots.
if dmidecode -t 11 2>/dev/null | grep -q wipestick-selftest-s3 && grep -qw mem /sys/power/state 2>/dev/null; then
  echo "SUSPEND-TEST: suspending for 5 s"
  if rtcwake -m mem -s 5 >/dev/null 2>&1; then
    sleep 3
    printf '\n\n   WIPESTICK SELF-TEST: RESUMED FROM SUSPEND - DISPLAY OK\n\n' > /dev/tty1
    echo "SUSPEND-TEST: resumed"
  else
    echo "FAIL: rtcwake suspend failed"; fail=1
  fi
else
  echo "SUSPEND-TEST: skipped (not requested, or no S3 in this VM)"
fi

targets=()
while IFS=$'\037' read -r dev _ _ _ serial _; do
  [[ $serial == WSTEST* ]] && targets+=("$dev")
done < <(tail -n +2 <<<"$list" | tr '\t' '\037')   # tabs collapse empty fields
echo "targets: ${targets[*]:-none}"
(( ${#targets[@]} )) || { echo "FAIL: no WSTEST drives found"; fail=1; }

# Interrupt check: stop an erase once it reaches the SATA zero pass; the
# summary must say INTERRUPTED. (SIGTERM: background jobs ignore SIGINT, and
# both run the same handler as Ctrl+C.) The real erase below then starts over.
if (( ${#targets[@]} )); then
  wipestick erase --confirm ERASE "${targets[@]}" >/dev/null 2>&1 &
  epid=$!
  for _ in $(seq 1 240); do
    grep -qs 'trying: Single zero pass' "$(cat /run/wipestick/log_dir 2>/dev/null)"/*.log && break
    sleep 0.5
  done
  kill -TERM "$epid" 2>/dev/null; wait "$epid"; erc=$?
  if (( erc == 130 )) && grep -q '|INTERRUPTED|' /run/wipestick/summary && [[ -e /run/wipestick/interrupted ]]; then
    echo "interrupt: ok"; grep '|INTERRUPTED|' /run/wipestick/summary
  else
    echo "FAIL: interrupt not recorded (exit $erc)"; cat /run/wipestick/summary; fail=1
  fi
fi

if (( ${#targets[@]} )); then
  wipestick plan "${targets[@]}"
  wipestick erase --confirm ERASE "${targets[@]}" || { echo "FAIL: erase returned non-zero"; fail=1; }
  cat /run/wipestick/summary 2>/dev/null
  logdir=$(cat /run/wipestick/log_dir 2>/dev/null)
  echo "log dir: $logdir"
  ls -la "$logdir" 2>/dev/null
fi

# Diagnostics command must run cleanly and write its file.
dfile=$(wipestick diag 2>&1 | tail -n1)
if [[ -s $dfile ]]; then echo "diag: ok ($dfile)"; grep -E '^TCG:|^=====' "$dfile"; else echo "FAIL: wipestick diag wrote no file"; fail=1; fi
grep -q '|Purge$' /run/wipestick/summary && grep -q '|Clear$' /run/wipestick/summary \
  && echo "grades: ok (NVMe Purge, SATA Clear)" || { echo "FAIL: unexpected grades"; cat /run/wipestick/summary; fail=1; }

if (( fail )); then echo "WIPESTICK-SELFTEST-FAIL"; else echo "WIPESTICK-SELFTEST-PASS"; fi
sync
systemctl poweroff 2>/dev/null || poweroff -f
