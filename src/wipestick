#!/usr/bin/env bash
# wipestick — firmware-first drive sanitizer for a bootable USB.
#
# Philosophy: ask the drive to erase itself (NVMe Sanitize / Format with
# Secure Erase, ATA Sanitize / Security Erase). These are fast and cause
# almost no flash wear. Fall back to TRIM, then a single zero pass, only
# when firmware methods are unavailable or fail verification.
#
# Every erase is verified with "canaries": random 4 KiB blocks written at
# spread-out offsets before the erase and read back afterwards. If any
# canary survives, the method is treated as failed and the next one is tried.
#
# Usage:
#   wipestick list                      # eligible drives (TSV)
#   wipestick plan  <dev>...            # show which methods will be tried
#   wipestick erase --confirm ERASE <dev>...
#   wipestick diag                      # save hardware diagnostics to the log folder
# Options (before the subcommand):
#   --dry-run       print destructive commands instead of running them
#   --allow-usb     include USB-attached drives in the eligible list
#   --no-suspend    never suspend to unfreeze SATA drives
#   --log-dir DIR   override log location
#
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail

VERSION="0.1.5"
DRY_RUN=0
ALLOW_USB=0
ALLOW_SUSPEND=1
LOG_DIR="${WIPESTICK_LOG_DIR:-}"
CANARY_COUNT=16
CANARY_BS=4096
ATA_PASS="wipestick"
STATE_DIR="/run/wipestick"
RUN_LOG="/dev/null"
POLL_SECS=${WIPESTICK_POLL_SECS:-5}
# A firmware sanitize reports progress as a counter out of 65535, so a drive
# that is really working moves it every few seconds, even on multi-hour jobs.
# If the counter does not move at all for this long, the drive has stalled.
STALL_SECS=${WIPESTICK_STALL_SECS:-300}
# Hard drives get longer, in case their firmware only updates progress coarsely.
STALL_SECS_HDD=${WIPESTICK_STALL_SECS_HDD:-1800}

# Set while an erase runs, so the Ctrl+C handler can say what was interrupted.
CUR_DEV=""; CUR_METHOD=""; CUR_DESC=""
LADDER_STOP=""     # set by a method when no later method can work this boot
PENDING_DEVS=()

# ---------------------------------------------------------------- utilities

die()  { echo "wipestick: $*" >&2; exit 2; }
ts()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
log()  { printf '%s %s\n' "$(ts)" "$*" | tee -a "$RUN_LOG" >&2; }
info() { printf '    %s\n' "$*" | tee -a "$RUN_LOG" >&2; }

# Run a destructive command (or print it in dry-run mode).
run() {
  if (( DRY_RUN )); then
    info "[dry-run] $*"
    return 0
  fi
  info "+ $*"
  "$@" 2>&1 | tee -a "$RUN_LOG" >&2
  return "${PIPESTATUS[0]}"
}

need_root() { [[ $EUID -eq 0 ]] || die "must run as root"; }

devname() { basename "$1"; }

parent_disk() {
  local pk
  pk=$(lsblk -no PKNAME "$1" 2>/dev/null | head -n1)
  if [[ -n $pk ]]; then echo "/dev/$pk"; else echo "$1"; fi
}

# Disks that must never be touched: the boot medium and anything backing /.
protected_disks() {
  local m src
  for m in /cdrom /run/live/medium /lib/live/mount/medium /mnt/wipelogs; do
    src=$(findmnt -no SOURCE "$m" 2>/dev/null) || continue
    [[ $src == /dev/* ]] && parent_disk "$src"
  done
  src=$(findmnt -no SOURCE / 2>/dev/null)
  [[ $src == /dev/* ]] && parent_disk "$src"
  src=$(blkid -L WIPELOGS 2>/dev/null) && parent_disk "$src"
  return 0
}

is_protected() {
  local d
  while read -r d; do [[ -n $d && $d == "$1" ]] && return 0; done < <(protected_disks | sort -u)
  return 1
}

classify() {
  local dev=$1 name tran rota
  name=$(devname "$dev")
  case $name in
    nvme*)   echo nvme; return ;;
    mmcblk*) echo mmc;  return ;;
  esac
  rota=$(cat "/sys/block/$name/queue/rotational" 2>/dev/null || echo 0)
  tran=$(lsblk -dno TRAN "$dev" 2>/dev/null | tr -d ' ')
  if [[ $rota == 1 ]]; then echo hdd
  elif [[ $tran == sata || $tran == ata ]]; then echo sata-ssd
  else echo ssd-other
  fi
}

size_bytes() { blockdev --getsize64 "$1"; }

# Decimal units, rounded to nearest, so sizes match drive labels (128GB, not 120GB).
human() { numfmt --to=si --round=nearest --suffix=B "$1" 2>/dev/null || echo "$1"; }

# ------------------------------------------------------------- enumeration

eligible_drives() {
  local name path tran type
  while read -r name type tran; do
    path="/dev/$name"
    [[ $type == disk || ( $type == loop && ${WIPESTICK_TEST_LOOP:-0} == 1 ) ]] || continue
    case $name in
      loop*) [[ ${WIPESTICK_TEST_LOOP:-0} == 1 ]] || continue ;;   # test hook only
      zram*|ram*|sr*|fd*|nbd*|md*|dm-*) continue ;;
    esac
    [[ $name == mmcblk*boot* || $name == mmcblk*rpmb ]] && continue
    [[ $tran == usb && $ALLOW_USB -eq 0 ]] && continue
    is_protected "$path" && continue
    [[ $(size_bytes "$path" 2>/dev/null || echo 0) -gt 0 ]] || continue
    echo "$path"
  done < <(lsblk -dnro NAME,TYPE,TRAN 2>/dev/null | awk '{print $1, $2, ($3==""?"-":$3)}')
}

cmd_list() {
  local d
  printf 'DEVICE\tCLASS\tSIZE\tMODEL\tSERIAL\tTRAN\n'
  for d in $(eligible_drives); do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$d" "$(classify "$d")" \
      "$(human "$(size_bytes "$d")")" \
      "$(lsblk -dno MODEL "$d" | sed 's/[[:space:]]*$//')" \
      "$(lsblk -dno SERIAL "$d" | sed 's/[[:space:]]*$//')" \
      "$(lsblk -dno TRAN "$d" | tr -d ' ')"
  done
}

# Platform-level warnings that explain missing drives or failed commands.
platform_warnings() {
  if compgen -G '/sys/bus/pci/drivers/vmd/*:*' >/dev/null; then
    echo "Intel VMD/RST is active. NVMe erase commands may be blocked; set storage mode to AHCI in firmware setup if erases fail."
  fi
  if lspci -n 2>/dev/null | awk '{print $2}' | grep -q '^0104'; then
    echo "A RAID-mode storage controller is present. Drives behind it may be hidden; switch to AHCI in firmware setup."
  fi
  return 0
}

# ------------------------------------------------------- progress watching

mmss() {
  if (( $1 >= 60 && $1 % 60 == 0 )); then echo "$(( $1 / 60 )) min"
  else printf '%dm%02ds' $(( $1 / 60 )) $(( $1 % 60 )); fi
}

stall_limit() {
  if [[ $(cat "/sys/block/$(devname "$1")/queue/rotational" 2>/dev/null) == 1 ]]; then
    echo "$STALL_SECS_HDD"
  else
    echo "$STALL_SECS"
  fi
}

# Shared by the sanitize loops: progress_reset <limit> before polling, then
# progress_tick <counter 0-65535> on every poll. Prints a line when the value
# changes and once a minute otherwise. Fails once it has not moved for <limit>.
progress_reset() { P_LAST=""; P_SINCE=$SECONDS; P_SAID=$SECONDS; P_LIMIT=$1; }
progress_tick() {
  local raw=$1 pct idle
  pct=$(( raw * 100 / 65535 ))
  if [[ $raw != "$P_LAST" ]]; then
    [[ -n $P_LAST ]] && P_SINCE=$SECONDS
    P_LAST=$raw; P_SAID=$SECONDS
    info "progress: $pct% ($(printf '0x%x' "$raw"))"
    return 0
  fi
  idle=$(( SECONDS - P_SINCE ))
  if (( idle >= P_LIMIT )); then
    info "STALLED: progress stuck at $pct% ($(printf '0x%x' "$raw")) for $(mmss "$idle")"
    return 1
  fi
  if (( SECONDS - P_SAID >= 60 )); then
    P_SAID=$SECONDS
    info "progress: $pct% (no change for $(mmss "$idle"); moving on at $(mmss "$P_LIMIT") without change)"
  fi
  return 0
}

# A sanitize that stalls once on a drive tends to stall again, so remember it
# on the log medium (it survives reboots) and skip that method next time.
drive_key() {
  local s
  s=$(lsblk -dno SERIAL "$1" 2>/dev/null | xargs)
  [[ -n $s ]] || s="$(lsblk -dno MODEL "$1" 2>/dev/null | xargs)-$(size_bytes "$1" 2>/dev/null)"
  echo "${s// /_}"
}
stall_file() { echo "${LOG_DIR:-$STATE_DIR}/stalled-drives.txt"; }
stalled_before() {   # stalled_before dev family(ata-sanitize|nvme-sanitize)
  grep -qs "^$(drive_key "$1")	$2	" "$(stall_file)"
}
record_stall() {
  stalled_before "$1" "$2" && return 0
  printf '%s\t%s\t%s\t%s\n' "$(drive_key "$1")" "$2" "$(lsblk -dno MODEL "$1" 2>/dev/null | xargs)" "$(ts)" >> "$(stall_file)"
  sync
}

# After a stall: if the drive is still busy, nothing else will work until it
# is power-cycled, so stop trying further methods on it this boot.
after_stall() {
  local dev=$1 family=$2 busy=$3
  record_stall "$dev" "$family"
  if (( busy )); then
    LADDER_STOP="Firmware erase stalled (no progress for $(mmss "$P_LIMIT")) and the drive is still busy with it, so it will refuse other erase methods until power-cycled. Power off, wait 10 seconds, boot WipeStick and erase again; this method will be skipped for this drive next time."
    info "drive is still busy with the stalled sanitize; skipping remaining methods"
  else
    info "drive left the stalled sanitize; trying the next method"
  fi
}

# ------------------------------------------------------------- nvme helpers

nvme_ctrl() {
  # /sys/block/nvme0n1/device -> .../nvme0
  echo "/dev/$(basename "$(readlink -f "/sys/block/$(devname "$1")/device")")"
}

nvme_idctrl_field() { nvme id-ctrl "$1" -o json 2>/dev/null | jq -r ".$2 // 0"; }

nvme_ns_count() {
  local c
  c=$(devname "$1")
  find /sys/class/nvme/"$c"/ -maxdepth 1 -name "${c}n*" 2>/dev/null | grep -c . || true
}

# TCG Level 0 Discovery over NVMe Security Receive. Prints one summary line,
# e.g. "TCG: Opal 2; locking supported, ENABLED, unlocked; Block SID set".
tcg_level0() {
  local ctrl=$1 f code flen i end len b out="" proto=""
  f=$(mktemp)
  if ! nvme security-recv "$ctrl" -p 1 -s 1 -x 2048 -t 2048 -b > "$f" 2>/dev/null || [[ ! -s $f ]]; then
    rm -f "$f"; echo "TCG: no response (not a self-encrypting drive, or not supported)"; return 1
  fi
  local -a B
  mapfile -t B < <(od -An -tu1 -v "$f" | tr -s ' ' '\n' | grep -v '^$')
  rm -f "$f"
  (( ${#B[@]} >= 48 )) || { echo "TCG: short response"; return 1; }
  len=$(( (B[0] << 24) | (B[1] << 16) | (B[2] << 8) | B[3] ))
  end=$(( len + 4 )); (( end > ${#B[@]} )) && end=${#B[@]}
  i=48
  while (( i + 4 <= end )); do
    code=$(( (B[i] << 8) | B[i+1] )); flen=${B[i+3]}
    b=${B[i+4]:-0}
    case $code in
      2)   out+="; locking $( (( b & 1 )) && echo supported || echo unsupported)"
           out+=", $( (( b & 2 )) && echo ENABLED || echo disabled)"
           out+=", $( (( b & 4 )) && echo LOCKED || echo unlocked)"
           (( b & 16 )) && out+=", MBR shadow enabled" ;;
      512) proto="Opal 1" ;;
      515) proto="Opal 2" ;;
      769|770|771) proto="Pyrite" ;;
      1026) (( b & 2 )) && out+="; Block SID set by firmware" ;;
    esac
    i=$(( i + 4 + flen ))
  done
  echo "TCG: ${proto:-unknown SSC}${out:-; no locking feature}"
}

tcg_locking_enabled() { tcg_level0 "$1" | grep -q 'ENABLED'; }

# Prints "<sstat> <sprog>" as numbers; "0 0" when the drive does not report them.
nvme_sstat() {
  local st prog
  read -r st prog < <(nvme sanitize-log "$1" -o json 2>/dev/null |
    jq -r '[.. | objects | select(has("sstat"))][0] | "\(.sstat) \(.sprog)"' 2>/dev/null)
  [[ ${st:-} =~ ^[0-9]+$ ]] || st=0
  [[ ${prog:-} =~ ^[0-9]+$ ]] || prog=0
  echo "$st $prog"
}

# One-line sanitize state for the summary screen.
nvme_sanitize_status() {
  local st prog
  [[ $(nvme_idctrl_field "$1" sanicap) != 0 ]] || return 0   # no sanitize support
  read -r st prog < <(nvme_sstat "$1")
  case $(( st & 7 )) in
    0) echo "NVMe sanitize status: never sanitized" ;;
    1|4) echo "NVMe sanitize status: last sanitize completed" ;;
    2) echo "NVMe sanitize status: IN PROGRESS, $(( ${prog:-0} * 100 / 65535 ))%" ;;
    3) echo "NVMe sanitize status: last sanitize FAILED" ;;
    *) echo "NVMe sanitize status: unknown (sstat=$st)" ;;
  esac
}

nvme_sanitize() {
  local dev=$1 act=$2 ctrl
  ctrl=$(nvme_ctrl "$dev")
  run nvme sanitize "$ctrl" --sanact="$act" || return 1
  (( DRY_RUN )) && return 0
  sleep 2
  nvme_sanitize_wait "$dev"
}

# Wait for a running NVMe sanitize: 0 finished, 1 failed or stalled.
nvme_sanitize_wait() {
  local dev=$1 ctrl st prog code waited=0
  ctrl=$(nvme_ctrl "$dev")
  progress_reset "$(stall_limit "$dev")"
  while :; do
    read -r st prog < <(nvme_sstat "$ctrl")
    code=$(( ${st:-0} & 7 ))
    case $code in
      2) progress_tick "${prog:-0}" || {
           read -r st prog < <(nvme_sstat "$ctrl")
           after_stall "$dev" nvme-sanitize $(( (${st:-0} & 7) == 2 ))
           return 1; } ;;
      1|4) info "sanitize completed (sstat=$st)"; break ;;
      3) info "sanitize reported FAILURE (sstat=$st)"
         run nvme sanitize "$ctrl" --sanact=1 >/dev/null 2>&1   # exit failure mode
         return 1 ;;
      *) info "unexpected sanitize status (sstat=${st:-none})"; (( waited > 30 )) && return 1 ;;
    esac
    sleep "$POLL_SECS"; waited=$(( waited + POLL_SECS ))
    (( waited > 43200 )) && { info "sanitize timed out after 12h"; return 1; }
  done
  nvme ns-rescan "$ctrl" >/dev/null 2>&1 || true
  sleep 1
  return 0
}

nvme_format() {
  local dev=$1 ses=$2 flbas lbaf
  flbas=$(nvme id-ns "$dev" -o json 2>/dev/null | jq -r '.flbas // 0')
  lbaf=$(( flbas & 0xF ))
  run nvme format "$dev" --ses="$ses" --lbaf="$lbaf" --force --timeout=3600000 || return 1
  nvme ns-rescan "$(nvme_ctrl "$dev")" >/dev/null 2>&1 || true
  sleep 1
}

# -------------------------------------------------------------- ata helpers

ata_info() { hdparm -I "$1" 2>/dev/null; }

ata_security_block() { ata_info "$1" | sed -n '/^Security:/,/^[^[:space:]]/p'; }

ata_has()  { ata_info "$1" | grep -q "$2"; }

ata_frozen() { ata_security_block "$1" | grep -qP '^\s+frozen'; }
ata_locked() { ata_security_block "$1" | grep -qP '^\s+locked'; }
ata_sec_enabled() { ata_security_block "$1" | grep -qP '^\s+enabled'; }
ata_sec_supported() { ata_security_block "$1" | grep -qP '^\s+supported$'; }
ata_enhanced() { ata_security_block "$1" | grep -qP 'supported: enhanced erase'; }

# Name of the DRM (kernel graphics) driver driving the display, or empty when
# only the firmware framebuffer is in use (nomodeset, or a blacklisted GPU).
# Simple/firmware framebuffer drivers do not restore the screen after resume.
display_driver() {
  local link drv
  for link in /sys/class/drm/card[0-9]*/device/driver; do
    [[ -e $link ]] || continue
    drv=$(basename "$(readlink -f "$link")")
    case $drv in simple-framebuffer|simpledrm|efi-framebuffer|vesa-framebuffer|efifb) continue ;; esac
    echo "$drv"; return 0
  done
  return 1
}
display_survives_suspend() { display_driver >/dev/null; }

try_unfreeze() {
  local dev=$1
  ata_frozen "$dev" || return 0
  if (( ! ALLOW_SUSPEND )); then info "drive is frozen and suspend is disabled"; return 1; fi
  if [[ -e $STATE_DIR/suspended ]]; then info "drive still frozen after suspend/resume"; return 1; fi
  info "drive is security-frozen by firmware; suspending for 6s to unfreeze..."
  if display_survives_suspend; then
    info "The screen will go dark for a few seconds and then come back."
  else
    info "NOTE: this machine has no graphics driver loaded, so the screen may stay"
    info "dark after this. The erase continues, and the machine powers off by itself"
    info "about a minute after it finishes."
  fi
  sleep 5   # give the operator time to read the note
  touch "$STATE_DIR/suspended"
  if (( DRY_RUN )); then info "[dry-run] rtcwake -m mem -s 6"; return 0; fi
  sync
  rtcwake -m mem -s 6 >/dev/null 2>&1 || info "suspend failed (platform may only support s2idle)"
  sleep 4
  ata_frozen "$dev" && { info "still frozen after resume"; return 1; }
  info "drive unfrozen"
  return 0
}

# Read ATA sanitize status into S_STATE (busy|done|idle|failed|frozen|unknown),
# S_RAW (progress counter 0-65535) and S_TEXT (one line for logs and summaries).
ata_sanitize_poll() {
  local out
  out=$(hdparm --sanitize-status "$1" 2>&1)
  S_RAW=0
  S_TEXT=$(grep -iE 'State:|Progress:|Without Error|Reason|Antifreeze|SG_IO|failed' <<<"$out" |
           sed 's/^[[:space:]]*//' | tr -s ' \t' '  ' | paste -sd';' - | sed 's/;/; /g')
  if grep -qiE 'in process|progress:' <<<"$out"; then
    S_STATE=busy
    S_RAW=$(grep -oiE 'progress: 0x[0-9a-f]+' <<<"$out" | grep -oiE '0x[0-9a-f]+' | head -n1)
    S_RAW=$(( ${S_RAW:-0} ))
  elif grep -qi 'operation failed' <<<"$out"; then S_STATE=failed
  elif grep -qi 'sanitize frozen' <<<"$out";  then S_STATE=frozen
  elif grep -qi 'completed without error' <<<"$out"; then S_STATE=complete
  elif grep -qi 'sanitize idle' <<<"$out"; then S_STATE=idle
  else S_STATE=unknown
  fi
  [[ -n $S_TEXT ]] || S_TEXT=$(xargs <<<"$out" 2>/dev/null | cut -c1-160)
  return 0
}

ata_sanitize_status() {
  ata_has "$1" 'SANITIZE feature set' || return 0
  ata_sanitize_poll "$1"
  echo "ATA sanitize status: ${S_TEXT:-not reported}"
}

ata_sanitize() {
  local dev=$1 op=$2 out rc
  if (( DRY_RUN )); then info "[dry-run] hdparm --yes-i-know-what-i-am-doing $op $dev"; return 0; fi
  info "+ hdparm --yes-i-know-what-i-am-doing $op $dev"
  out=$(hdparm --yes-i-know-what-i-am-doing "$op" "$dev" 2>&1); rc=$?
  printf '%s\n' "$out" | tee -a "$RUN_LOG" >&2
  # hdparm can report "Operation started" even when the drive aborted the
  # command; the abort only shows up as SG_IO sense data. Treat it as failure.
  if (( rc != 0 )) || grep -qiE 'SG_IO|sense data|aborted' <<<"$out"; then
    info "drive rejected the sanitize command"
    return 1
  fi
  sleep 2
  ata_sanitize_wait "$dev"
}

# Wait for a running ATA sanitize: 0 finished, 1 failed or stalled.
ata_sanitize_wait() {
  local dev=$1 seen_busy=0 waited=0
  progress_reset "$(stall_limit "$dev")"
  while :; do
    ata_sanitize_poll "$dev"
    case $S_STATE in
      busy)
        seen_busy=1
        if ! progress_tick "$S_RAW"; then
          ata_sanitize_poll "$dev"
          info "sanitize status: $S_TEXT"
          after_stall "$dev" ata-sanitize "$([[ $S_STATE == busy ]] && echo 1 || echo 0)"
          return 1
        fi ;;
      complete)
        (( seen_busy )) || info "sanitize reported complete without a visible in-progress state (verification will confirm)"
        info "sanitize completed"; return 0 ;;
      failed) info "sanitize failed: $S_TEXT"; return 1 ;;
      frozen) info "sanitize is frozen by firmware: $S_TEXT"; return 1 ;;
      *)
        if (( seen_busy )); then info "sanitize finished ($S_TEXT); verification will confirm"; return 0; fi
        (( waited > 30 )) && { info "sanitize status unclear: $S_TEXT"; return 0; } ;;
    esac
    sleep "$POLL_SECS"; waited=$(( waited + POLL_SECS ))
    (( waited > 43200 )) && { info "sanitize timed out after 12h"; return 1; }
  done
}

# Never leave a password on the drive, whatever happened, and say so
# explicitly in the log so the erase report shows the drive is unlocked.
clear_temp_password() {
  local dev=$1
  (( DRY_RUN )) && return 0
  if ata_sec_enabled "$dev"; then
    info "clearing temporary ATA password"
    hdparm --user-master u --security-disable "$ATA_PASS" "$dev" >/dev/null 2>&1
  fi
  if ata_sec_enabled "$dev"; then
    info "WARNING: ATA password is still set on $dev. It is: $ATA_PASS"
    info "Unlock with: hdparm --user-master u --security-disable $ATA_PASS $dev"
    touch "$STATE_DIR/pwstuck.$(devname "$dev")"
    return 1
  fi
  info "ATA security: no password set (drive unlocked)"
  return 0
}

ata_security_erase() {
  local dev=$1 mode rc
  try_unfreeze "$dev" || return 1
  if ata_locked "$dev"; then info "drive is ATA-password locked; cannot erase without its password"; return 1; fi
  mode="--security-erase"
  ata_enhanced "$dev" && mode="--security-erase-enhanced"
  run hdparm --user-master u --security-set-pass "$ATA_PASS" "$dev" || return 1
  run hdparm --user-master u "$mode" "$ATA_PASS" "$dev"; rc=$?
  clear_temp_password "$dev" || rc=1
  return "$rc"
}

# ----------------------------------------------------------- generic methods

discard() { run blkdiscard -f "$1"; }
secure_discard() { run blkdiscard -f -s "$1"; }

zero_fill() {
  local dev=$1 size mib rem lbs
  size=$(size_bytes "$dev"); mib=$(( size / 1048576 )); rem=$(( size % 1048576 ))
  lbs=$(blockdev --getss "$dev")
  info "writing zeros over $(human "$size") — this can take hours on large HDDs"
  run dd if=/dev/zero of="$dev" bs=1M count="$mib" oflag=direct status=progress || return 1
  if (( rem > 0 )); then
    run dd if=/dev/zero of="$dev" bs="$lbs" seek=$(( mib * 1048576 / lbs )) count=$(( rem / lbs )) oflag=direct || return 1
  fi
  run sync
}

# ---------------------------------------------------------------- canaries

canary_offsets() {
  local size=$1 i step last
  last=$(( (size / CANARY_BS - 1) * CANARY_BS ))
  step=$(( size / CANARY_COUNT / 1048576 * 1048576 ))
  (( step < 1048576 )) && step=1048576
  for (( i = 0; i < CANARY_COUNT - 1; i++ )); do
    local o=$(( i * step + 1048576 ))
    (( o > last )) && break
    echo "$o"
  done
  echo "$last"
}

canary_plant() {
  local dev=$1 dir=$2 off ok=0 total=0
  head -c "$CANARY_BS" /dev/urandom > "$dir/canary.bin"
  sha256sum < "$dir/canary.bin" | cut -d' ' -f1 > "$dir/canary.sha"
  canary_offsets "$(size_bytes "$dev")" > "$dir/offsets"
  if (( DRY_RUN )); then info "[dry-run] would plant $(wc -l < "$dir/offsets") canaries"; return 0; fi
  while read -r off; do
    total=$(( total + 1 ))
    dd if="$dir/canary.bin" of="$dev" bs="$CANARY_BS" seek=$(( off / CANARY_BS )) count=1 \
       oflag=direct,sync conv=notrunc status=none 2>/dev/null && ok=$(( ok + 1 ))
  done < "$dir/offsets"
  info "planted $ok/$total canaries"
  (( ok == total ))
}

# Prints "erased/total" and succeeds only if every canary is gone and readable.
canary_check() {
  local dev=$1 dir=$2 off gone=0 total=0 unreadable=0 want got
  want=$(cat "$dir/canary.sha")
  blockdev --flushbufs "$dev" 2>/dev/null
  while read -r off; do
    total=$(( total + 1 ))
    if dd if="$dev" of="$dir/read.bin" bs="$CANARY_BS" skip=$(( off / CANARY_BS )) count=1 \
          iflag=direct status=none 2>/dev/null && [[ -s $dir/read.bin ]]; then
      got=$(sha256sum < "$dir/read.bin" | cut -d' ' -f1)
      [[ $got != "$want" ]] && gone=$(( gone + 1 ))
    else
      unreadable=$(( unreadable + 1 ))
    fi
  done < "$dir/offsets"
  echo "$gone/$total"
  (( unreadable > 0 )) && info "$unreadable canary locations unreadable (drive may be locked)"
  (( gone == total && unreadable == 0 ))
}

# ---------------------------------------------------------------- teardown

teardown() {
  local dev=$1 name type mnt
  # Unmount and deactivate anything stacked on the disk, deepest first.
  while read -r name type mnt; do
    [[ $name == "$dev" ]] && continue
    if [[ $mnt == "[SWAP]" ]]; then run swapoff "$name"
    elif [[ -n $mnt && $mnt != "-" ]]; then run umount -l "$name"
    fi
    case $type in
      crypt|lvm|dm) run dmsetup remove --force "$name" ;;
      raid*)        run mdadm --stop "$name" ;;
    esac
  done < <(lsblk -nrpo NAME,TYPE,MOUNTPOINT "$dev" 2>/dev/null | awk '{print $1, $2, ($3==""?"-":$3)}' | tac)
  return 0
}

finalize() {
  local dev=$1
  run wipefs -a -f "$dev" >/dev/null
  run sgdisk --zap-all "$dev" >/dev/null
  run blockdev --rereadpt "$dev" 2>/dev/null
  run partprobe "$dev" 2>/dev/null
  return 0
}

# ---------------------------------------------------------- method ladders

# Each ladder prints one method per line: "<id>|<description>".
methods_for() {
  local dev=$1 class ctrl sanicap fna
  class=$(classify "$dev")
  case $class in
    nvme)
      ctrl=$(nvme_ctrl "$dev")
      sanicap=$(nvme_idctrl_field "$ctrl" sanicap)
      fna=$(nvme_idctrl_field "$ctrl" fna)
      (( sanicap & 1 )) && echo "nvme-sanitize-crypto|NVMe Sanitize (crypto erase)"
      (( sanicap & 2 )) && echo "nvme-sanitize-block|NVMe Sanitize (block erase)"
      (( fna & 4 ))     && echo "nvme-format-crypto|NVMe Format, crypto erase (SES=2)"
      echo "nvme-format-user|NVMe Format, user data erase (SES=1)"
      echo "zero-trim|Single zero pass, then TRIM"
      ;;
    sata-ssd|ssd-other)
      ata_has "$dev" CRYPTO_SCRAMBLE_EXT && echo "ata-sanitize-crypto|ATA Sanitize (crypto scramble)"
      ata_has "$dev" BLOCK_ERASE_EXT     && echo "ata-sanitize-block|ATA Sanitize (block erase)"
      ata_sec_supported "$dev"           && echo "ata-secure-erase|ATA Security Erase$(ata_enhanced "$dev" && echo ' (enhanced)')"
      echo "zero-trim|Single zero pass, then TRIM"
      ;;
    hdd)
      echo "zero|Single zero pass (NIST 800-88 Clear)"
      ;;
    mmc)
      echo "mmc-secure-discard|eMMC secure erase/trim"
      echo "zero-trim|Single zero pass, then TRIM"
      ;;
  esac
}

apply_method() {
  local dev=$1 m=$2
  case $m in
    nvme-sanitize-crypto) nvme_sanitize "$dev" 4 ;;
    nvme-sanitize-block)  nvme_sanitize "$dev" 2 ;;
    nvme-format-crypto)   nvme_format "$dev" 2 ;;
    nvme-format-user)     nvme_format "$dev" 1 ;;
    ata-sanitize-crypto)  ata_sanitize "$dev" --sanitize-crypto-scramble ;;
    ata-sanitize-block)   ata_sanitize "$dev" --sanitize-block-erase ;;
    ata-secure-erase)     ata_security_erase "$dev" ;;
    mmc-secure-discard)   secure_discard "$dev" ;;
    discard)              discard "$dev" ;;
    zero-trim)            zero_fill "$dev" && { discard "$dev" || info "TRIM after zero pass not supported (fine)"; true; } ;;
    zero)                 zero_fill "$dev" ;;
    *) return 1 ;;
  esac
}

# Strength of each method, in NIST SP 800-88 terms.
#   Purge   - firmware erase of all media, including spare/remapped areas
#   Clear   - every user-addressable block overwritten
#   Logical - blocks unmapped (TRIM); data may remain in flash until reused
grade_of() {
  case $1 in
    nvme-sanitize-*|nvme-format-*|ata-sanitize-*|ata-secure-erase) echo Purge ;;
    zero|zero-trim|mmc-secure-discard) echo Clear ;;
    discard) echo Logical ;;
    *) echo - ;;
  esac
}

# ---------------------------------------------------------------- logging

# Find (and mount) where logs go: WIPELOGS partition, else the FAT32 boot
# stick, else RAM. Sets LOG_DIR and RUN_ID without creating any file.
resolve_log_dir() {
  mkdir -p "$STATE_DIR"
  if [[ -z $LOG_DIR ]]; then
    local part fstype
    if part=$(blkid -L WIPELOGS 2>/dev/null); then
      mkdir -p /mnt/wipelogs
      mountpoint -q /mnt/wipelogs || mount "$part" /mnt/wipelogs 2>/dev/null
      mountpoint -q /mnt/wipelogs && LOG_DIR=/mnt/wipelogs/wipelogs
    fi
    # Boot medium: /cdrom (Ubuntu casper) or /run/live/medium (Debian live-boot).
    # If it is a FAT32 stick (make-usb.sh / Rufus), remount it writable for logs.
    local medium
    for medium in /run/live/medium /cdrom; do
      [[ -z $LOG_DIR ]] && mountpoint -q "$medium" || continue
      fstype=$(findmnt -no FSTYPE "$medium")
      if [[ $fstype == vfat ]] && mount -o remount,rw "$medium" 2>/dev/null; then
        LOG_DIR=$medium/wipelogs
      fi
    done
    [[ -z $LOG_DIR ]] && LOG_DIR=$STATE_DIR/logs
  fi
  mkdir -p "$LOG_DIR"
  echo "$LOG_DIR" > "$STATE_DIR/log_dir"
  HOST_SERIAL=$(dmidecode -s system-serial-number 2>/dev/null | head -n1 | tr -c 'A-Za-z0-9_\n-' '_' )
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)_${HOST_SERIAL:-unknown}"
}

init_logs() {
  resolve_log_dir
  local host_serial=$HOST_SERIAL
  RUN_LOG="$LOG_DIR/$RUN_ID.log"
  REPORT="$LOG_DIR/$RUN_ID.jsonl"
  {
    echo "wipestick $VERSION  run $RUN_ID"
    echo "system: $(dmidecode -s system-manufacturer 2>/dev/null | head -n1) $(dmidecode -s system-product-name 2>/dev/null | head -n1) serial=$host_serial"
    echo "kernel: $(uname -r)  dry_run=$DRY_RUN"
  } >> "$RUN_LOG"
  [[ $LOG_DIR == "$STATE_DIR"/* ]] && log "NOTE: logs are in RAM ($LOG_DIR) and will be lost at reboot"
  return 0
}

# A grade only means something for a drive that was actually erased.
grade_for() { if [[ $2 == OK || $2 == DRY-RUN ]]; then grade_of "$1"; else echo -; fi; }

report() {
  # report dev class method result canaries notes
  jq -cn --arg time "$(ts)" --arg run "$RUN_ID" --arg dev "$1" --arg class "$2" \
    --arg model "$(lsblk -dno MODEL "$1" 2>/dev/null | xargs)" \
    --arg serial "$(lsblk -dno SERIAL "$1" 2>/dev/null | xargs)" \
    --arg size "$(size_bytes "$1" 2>/dev/null)" \
    --arg host_model "$(dmidecode -s system-product-name 2>/dev/null | head -n1)" \
    --arg host_serial "$(dmidecode -s system-serial-number 2>/dev/null | head -n1)" \
    --arg method "$3" --arg result "$4" --arg canaries "$5" --arg notes "$6" --argjson dry "$DRY_RUN" \
    --arg grade "$(grade_for "$3" "$4")" \
    '{time:$time,run:$run,host_model:$host_model,host_serial:$host_serial,device:$dev,class:$class,model:$model,serial:$serial,size_bytes:($size|tonumber? // null),method:$method,grade:$grade,result:$result,canaries_erased:$canaries,notes:$notes,dry_run:($dry==1)}' \
    >> "$REPORT"
  echo "$(devname "$1")|$4|$3|$5|$6|$(grade_for "$3" "$4")" >> "$STATE_DIR/summary"
}

# --------------------------------------------------------------- commands

# Save hardware details useful for figuring out why an erase method failed.
cmd_diag() {
  local d ctrl out
  resolve_log_dir
  out="$LOG_DIR/${RUN_ID}_diag.txt"
  {
    echo "wipestick $VERSION diagnostics  $(ts)"
    echo "system: $(dmidecode -s system-manufacturer 2>/dev/null | head -n1) $(dmidecode -s system-product-name 2>/dev/null | head -n1) bios=$(dmidecode -s bios-version 2>/dev/null | head -n1)"
    echo "kernel: $(uname -r)"
    echo "display: $(display_driver || echo 'firmware framebuffer (screen will not return after suspend)')"; echo
    platform_warnings; echo
    lsblk -o NAME,SIZE,TYPE,TRAN,ROTA,MODEL,SERIAL,MOUNTPOINTS; echo
    for d in $(eligible_drives); do
      echo "===== $d [$(classify "$d")]"
      case $(classify "$d") in
        nvme)
          ctrl=$(nvme_ctrl "$d")
          tcg_level0 "$ctrl"
          nvme id-ctrl "$ctrl" -H 2>&1 | grep -iE '^(mn|fr|oacs|sanicap|fna|frmw)|crypto|format|sanitiz|security'
          nvme id-ns "$d" 2>&1 | grep -E '^(nsze|flbas|lbaf)'
          nvme sanitize-log "$ctrl" 2>&1 | head -n 12
          nvme error-log "$ctrl" -e 8 2>&1 | grep -E 'Entry|error_count|status_field|opcode' | head -n 32
          ;;
        *)
          hdparm -I "$d" 2>&1 | sed -n '/^Model/,/^Logical/p;/Security:/,/^[^[:space:]]/p;/SANITIZE/p;/CRYPTO_SCRAMBLE/p;/BLOCK_ERASE/p'
          ata_sanitize_status "$d"
          ;;
      esac
      stalled_before "$d" ata-sanitize && echo "NOTE: ATA Sanitize stalled on this drive in an earlier run; it will be skipped"
      stalled_before "$d" nvme-sanitize && echo "NOTE: NVMe Sanitize stalled on this drive in an earlier run; it will be skipped"
      echo "plan:"; methods_for "$d" | cut -d'|' -f2 | sed 's/^/  /'
      echo
    done
  } > "$out" 2>&1
  sync
  echo "$out"
}

cmd_plan() {
  local dev m n=0
  resolve_log_dir   # to find the stalled-drives list
  for dev in "$@"; do
    echo "$dev  [$(classify "$dev")]  $(human "$(size_bytes "$dev")")  $(lsblk -dno MODEL "$dev" | xargs)"
    if [[ $(classify "$dev") == nvme ]] && (( $(nvme_ns_count "$(nvme_ctrl "$dev")") > 1 )); then
      echo "    NOTE: controller has multiple namespaces; sanitize erases all of them"
    fi
    n=0
    while IFS='|' read -r m desc; do
      if skip_reason "$dev" "$m" >/dev/null; then echo "    -  $desc (skipped: $(skip_reason "$dev" "$m"))"; continue; fi
      n=$(( n + 1 )); echo "    $n. $desc"
    done < <(methods_for "$dev")
  done
}

# Prints why a method is skipped for this drive, or fails if it is not.
skip_reason() {
  case $2 in
    ata-sanitize-*)  stalled_before "$1" ata-sanitize  && { echo "it stalled on this drive in an earlier run"; return 0; } ;;
    nvme-sanitize-*) stalled_before "$1" nvme-sanitize && { echo "it stalled on this drive in an earlier run"; return 0; } ;;
  esac
  return 1
}

# Current sanitize state, for summaries of drives that were not erased.
sanitize_status_of() {
  case $(classify "$1") in
    nvme) nvme_sanitize_status "$(nvme_ctrl "$1")" ;;
    mmc)  ;;
    *)    ata_sanitize_status "$1" ;;
  esac
}

# A sanitize keeps running inside the drive across reboots. If one is still
# going from an earlier attempt, wait for it before anything else (the drive
# refuses reads and writes meanwhile). Fails if it stalls or fails.
wait_for_leftover_sanitize() {
  local dev=$1 st prog
  case $(classify "$dev") in
    nvme)
      read -r st prog < <(nvme_sstat "$(nvme_ctrl "$dev")")
      (( (${st:-0} & 7) == 2 )) || return 0
      info "drive is still running a sanitize from an earlier attempt; waiting for it to finish"
      CUR_METHOD=nvme-sanitize-leftover; CUR_DESC="NVMe Sanitize left running by an earlier attempt"
      nvme_sanitize_wait "$dev" ;;
    mmc) return 0 ;;
    *)
      ata_has "$dev" 'SANITIZE feature set' || return 0
      ata_sanitize_poll "$dev"
      [[ $S_STATE == busy ]] || return 0
      info "drive is still running a sanitize from an earlier attempt; waiting for it to finish"
      CUR_METHOD=ata-sanitize-leftover; CUR_DESC="ATA Sanitize left running by an earlier attempt"
      ata_sanitize_wait "$dev" ;;
  esac
}

erase_one() {
  local dev=$1 class dir m desc result="FAILED" used="none" canaries="-" notes="" planted=1
  class=$(classify "$dev")
  dir=$(mktemp -d "$STATE_DIR/$(devname "$dev").XXXX")
  CUR_DIR=$dir; CUR_DEV=$dev; CUR_METHOD=""; CUR_DESC=""; LADDER_STOP=""
  log "=== $dev  [$class]  $(human "$(size_bytes "$dev")")  $(lsblk -dno MODEL,SERIAL "$dev" | xargs)"

  rm -f "$STATE_DIR/pwstuck.$(devname "$dev")"
  [[ $class == nvme ]] && info "$(tcg_level0 "$(nvme_ctrl "$dev")")"
  teardown "$dev"

  if (( ! DRY_RUN )) && ! wait_for_leftover_sanitize "$dev"; then
    notes=${LADDER_STOP:-"A sanitize left running by an earlier attempt did not finish."}
    LADDER_STOP=${LADDER_STOP:-x}
  fi
  CUR_METHOD=""; CUR_DESC=""

  if [[ -z $LADDER_STOP ]]; then
    canary_plant "$dev" "$dir" || { planted=0; notes="canary write failed (drive may be locked: SED/Opal or ATA password)"; info "$notes"; }

    while IFS='|' read -r m desc; do
      if skip_reason "$dev" "$m" >/dev/null; then
        log "--- skipping: $desc ($(skip_reason "$dev" "$m"))"; continue
      fi
      log "--- trying: $desc"
      CUR_METHOD=$m; CUR_DESC=$desc
      if ! apply_method "$dev" "$m"; then
        info "method failed: $desc"
        if [[ $m == nvme-* && -z $notes ]] && tcg_locking_enabled "$(nvme_ctrl "$dev")"; then
          notes="Self-encryption locking (TCG Opal) is enabled on this drive and may be blocking firmware erase. Remove the BIOS hard disk password or BitLocker hardware encryption, or PSID-revert the drive."
          info "$notes"
        fi
        # A drive left with an ATA password locks itself at next power-on.
        # Never report such a drive as OK, whatever later methods achieve.
        if [[ -e $STATE_DIR/pwstuck.$(devname "$dev") ]]; then
          notes="ATA password '$ATA_PASS' is still set; the drive will be locked at next power-on. Unlock from the root shell: hdparm --user-master u --security-disable $ATA_PASS $dev"
          break
        fi
        [[ -n $LADDER_STOP ]] && { notes=$LADDER_STOP; break; }
        continue
      fi
      if (( DRY_RUN )); then used=$m; result="DRY-RUN"; break; fi
      if canaries=$(canary_check "$dev" "$dir"); then
        info "verified: $canaries canaries erased"
        used=$m; result="OK"; break
      fi
      info "verification failed after $desc (canaries erased: $canaries); trying next method"
    done < <(methods_for "$dev")
  fi
  CUR_METHOD=""; CUR_DESC=""

  if [[ $result == OK || $result == DRY-RUN ]]; then
    finalize "$dev"
    (( planted )) || notes="verified by readback only; ${notes}"
  else
    [[ $notes == "canary write failed"* ]] && notes="$notes. If this is a self-encrypting drive, run a PSID revert using the PSID printed on its label."
    local st; st=$(sanitize_status_of "$dev")
    [[ -n $st ]] && { info "$st"; notes="${notes:+$notes }$st"; }
  fi
  log "=== $dev: $result via $used (grade: $(grade_of "$used"))"
  report "$dev" "$class" "$used" "$result" "$canaries" "$notes"
  rm -rf "$dir"
  CUR_DEV=""
  [[ $result == OK || $result == DRY-RUN ]]
}

# Ctrl+C (or the service being stopped) during an erase: record what was
# interrupted, so the summary screen and the report can say so.
on_interrupt() {
  trap '' INT TERM HUP
  echo >&2
  log "INTERRUPTED by operator"
  local dev notes st
  if [[ -n $CUR_DEV ]]; then
    case $CUR_METHOD in
      ata-secure-erase) clear_temp_password "$CUR_DEV" >/dev/null 2>&1 ;;
    esac
    if [[ -n $CUR_METHOD ]]; then
      notes="Stopped by operator during $CUR_DESC. Treat this drive as NOT erased: some or all data may remain."
      case $CUR_METHOD in
        *sanitize*) notes+=" The drive's firmware keeps erasing on its own once started, and refuses access until it finishes or is power-cycled." ;;
        ata-secure-erase) notes+=" Security Erase cannot be cancelled inside the drive; run the erase again to finish and verify it." ;;
      esac
    else
      notes="Stopped by operator before erasing began. The drive was not erased."
    fi
    [[ -e $STATE_DIR/pwstuck.$(devname "$CUR_DEV") ]] && notes+=" ATA password '$ATA_PASS' is still set; unlock from the root shell: hdparm --user-master u --security-disable $ATA_PASS $CUR_DEV"
    st=$(sanitize_status_of "$CUR_DEV")
    [[ -n $st ]] && { info "$st"; notes+=" $st"; }
    report "$CUR_DEV" "$(classify "$CUR_DEV")" "${CUR_METHOD:-none}" INTERRUPTED - "$notes"
  fi
  for dev in "${PENDING_DEVS[@]}"; do
    report "$dev" "$(classify "$dev")" none "NOT STARTED" - "Not erased: stopped by operator before this drive was started."
  done
  [[ -n ${CUR_DIR:-} ]] && rm -rf "$CUR_DIR"
  touch "$STATE_DIR/interrupted"
  sync
  exit 130
}

cmd_erase() {
  local confirm="" dev fails=0 eligible
  [[ ${1:-} == --confirm ]] || die "erase requires --confirm ERASE"
  confirm=${2:-}; shift 2
  [[ $confirm == ERASE ]] || die "confirmation token must be ERASE"
  (( $# > 0 )) || die "no devices given"
  eligible=$(eligible_drives)
  for dev in "$@"; do
    [[ -b $dev ]] || die "$dev is not a block device"
    is_protected "$dev" && die "$dev is the boot/log medium; refusing"
    grep -qx "$dev" <<<"$eligible" || die "$dev is not an eligible drive (see 'wipestick list')"
  done
  init_logs
  : > "$STATE_DIR/summary"
  rm -f "$STATE_DIR/suspended" "$STATE_DIR/interrupted"
  trap on_interrupt INT TERM HUP
  local w; while read -r w; do [[ -n $w ]] && log "WARNING: $w"; done < <(platform_warnings)
  PENDING_DEVS=("$@")
  for dev in "$@"; do
    PENDING_DEVS=("${PENDING_DEVS[@]:1}")
    erase_one "$dev" || fails=$(( fails + 1 ))
  done
  trap - INT TERM HUP
  sync
  log "done: $(( $# - fails ))/$# drives erased. Log: $RUN_LOG"
  (( fails == 0 ))
}

main() {
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --dry-run)    DRY_RUN=1 ;;
      --allow-usb)  ALLOW_USB=1 ;;
      --no-suspend) ALLOW_SUSPEND=0 ;;
      --log-dir)    LOG_DIR=$2; shift ;;
      --version)    echo "wipestick $VERSION"; exit 0 ;;
      --help)       sed -n '2,25p' "$0"; exit 0 ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  need_root
  mkdir -p "$STATE_DIR"
  case ${1:-} in
    list)     cmd_list ;;
    warnings) platform_warnings ;;
    plan)     shift; cmd_plan "$@" ;;
    diag)     cmd_diag ;;
    display)  display_driver || { echo "firmware framebuffer"; exit 1; } ;;
    erase)    shift; cmd_erase "$@" ;;
    *) die "usage: wipestick [--dry-run] [--allow-usb] {list|plan|diag|erase --confirm ERASE} [dev...]" ;;
  esac
}

main "$@"
