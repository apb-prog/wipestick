#!/usr/bin/env bash
# wipestick-tui - type-to-confirm front end for wipestick.
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail
ENGINE=${WIPESTICK_ENGINE:-/usr/local/sbin/wipestick}
TITLE="WipeStick"
export WIPESTICK_ACTIVE=1
export NEWT_COLORS='root=,red window=,black border=white,black textbox=white,black button=black,white title=white,black checkbox=white,black actcheckbox=black,white entry=white,black'

dims() { H=$(( $(tput lines) - 4 )); W=$(( $(tput cols) - 8 )); (( W > 100 )) && W=100; }

OK_BTN="Press Enter to Continue"
CANCEL_BTN="Press Esc to Cancel"
# Message box sized to its text. No --scrolltext: with it, whiptail ignores
# Enter until Tab moves focus to the button, which confuses operators.
msg() {
  local text=$1 btn=${2:-$OK_BTN} line need=7 inner
  dims
  inner=$(( W - 4 ))
  while IFS= read -r line; do
    need=$(( need + (${#line} + inner - 1) / inner ))
    (( ${#line} == 0 )) && need=$(( need + 1 ))
  done <<<"$text"
  (( need > H )) && need=$H
  whiptail --title "$TITLE" --ok-button "$btn" --msgbox "$text" "$need" "$W"
  MSG_RC=$?
  return "$MSG_RC"
}
yesno() { dims; whiptail --title "$TITLE" --yes-button "$2" --no-button "$3" --yesno "$1" "$H" "$W"; }

sysinfo() {
  printf '%s %s (S/N %s)' "$(dmidecode -s system-manufacturer 2>/dev/null | head -n1)" \
    "$(dmidecode -s system-product-name 2>/dev/null | head -n1)" \
    "$(dmidecode -s system-serial-number 2>/dev/null | head -n1)"
}

# Power off or reboot with a clean screen: silence the kernel console and
# systemd's shutdown status lines (the live medium cannot be unmounted while
# the system runs from it, which otherwise prints harmless "Failed unmounting"
# messages).
shutdown_quietly() {
  local action=$1 note=${2:-}
  sync
  dmesg -n 1 2>/dev/null
  mount -o remount,ro /run/live/medium 2>/dev/null || mount -o remount,ro /cdrom 2>/dev/null || true
  clear
  if [[ $action == reboot ]]; then echo "WipeStick: rebooting..."; else echo "WipeStick: powering off..."; fi
  [[ -n $note ]] && printf '\n%b\n' "$note"
  setterm --cursor off 2>/dev/null
  systemctl "$action" 2>/dev/null || "$action" -f
  sleep 30
}

POWERCYCLE_NOTE="When the machine is off, wait 10 seconds, then press the power button
and boot WipeStick again to finish the erase."

# A drive stuck in a firmware erase only recovers when it loses power, and a
# reboot usually keeps it powered. So in that case offer no Reboot or Start
# over: power off is the way forward (shell and diagnostics stay for admins).
needs_powercycle() { [[ -e /run/wipestick/needs-powercycle ]]; }

end_menu() {
  local choice
  dims
  if needs_powercycle; then
    while :; do
      choice=$(whiptail --title "$TITLE" --nocancel --notags --ok-button "$OK_BTN" --menu \
        "A drive needs a full power-off before it can be erased. Reboot is not offered, because it usually keeps the drive powered." 16 64 3 \
        poweroff "Power off" \
        diag     "Save diagnostics to the USB stick" \
        shell    "Drop to a root shell" 3>&1 1>&2 2>&3) || continue
      case $choice in
        poweroff) shutdown_quietly poweroff "$POWERCYCLE_NOTE" ;;
        shell)    clear; echo "Type 'exit' to return to WipeStick."; bash -l ;;
        diag)     msg "Diagnostics saved to:
$("$ENGINE" diag 2>&1 | tail -n1)" ;;
      esac
    done
  fi
  choice=$(whiptail --title "$TITLE" --nocancel --notags --ok-button "$OK_BTN" --menu "What next?" 15 64 5 \
    poweroff "Power off" \
    reboot   "Reboot" \
    again    "Start over" \
    diag     "Save diagnostics to the USB stick" \
    shell    "Drop to a root shell" 3>&1 1>&2 2>&3) || choice=again
  case $choice in
    poweroff) shutdown_quietly poweroff ;;
    reboot)   shutdown_quietly reboot ;;
    shell)    clear; echo "Type 'exit' to return to WipeStick."; bash -l ;;
    diag)     msg "Diagnostics saved to:
$("$ENGINE" diag 2>&1 | tail -n1)" ;;
  esac
}

main_loop() {
  local list warnings items=() dev class size model serial selected plan typed

  # Unit separator instead of tabs: bash collapses empty tab-separated fields.
  list=$("$ENGINE" list | tail -n +2 | tr '\t' '\037')
  warnings=$("$ENGINE" warnings)

  if [[ -z $list ]]; then
    msg "No internal drives were found.

$(sysinfo)

${warnings:-If this machine has a drive, check firmware setup: set the storage/SATA mode to AHCI (not RAID/RST/VMD) and make sure the drive is enabled.}"
    end_menu; return
  fi

  while IFS=$'\037' read -r dev class size model serial _; do
    items+=("$dev" "$(printf '%-9s %-8s %s  %s' "$size" "$class" "${model:-?}" "${serial:+S/N $serial}")" ON)
  done <<<"$list"

  dims
  # List height: one row per drive (plus one), but always leave room for the
  # instructions above it.
  local lh=$(( ${#items[@]} / 3 + 1 )) max_lh=$(( H - 16 ))
  (( max_lh < 3 )) && max_lh=3
  (( lh > max_lh )) && lh=$max_lh
  selected=$(whiptail --title "$TITLE" --separate-output \
    --ok-button "$OK_BTN" --cancel-button "$CANCEL_BTN" \
    --checklist "$(sysinfo)
${warnings:+
WARNING: $warnings
}
Select drives to Erase.
Press Space to toggle, Enter to continue or Esc to cancel.
The USB stick itself is not listed." \
    "$H" "$W" "$lh" "${items[@]}" 3>&1 1>&2 2>&3) || { end_menu; return; }
  [[ -z $selected ]] && { msg "Nothing selected."; return; }

  # shellcheck disable=SC2086
  plan=$("$ENGINE" plan $selected 2>&1)
  dims
  typed=$(whiptail --title "$TITLE - CONFIRM" --ok-button "$OK_BTN" --cancel-button "$CANCEL_BTN" \
    --inputbox "ALL DATA on listed drives will be permanently destroyed.
Each method is tried in order until one is verified:

$plan

Type ERASE (ALL CAPS) and press Enter to continue, or Esc to cancel and return to drive selection menu." "$H" "$W" 3>&1 1>&2 2>&3) || return
  if [[ $typed != ERASE ]]; then
    msg "Confirmation text did not match. No drives have been wiped.
Press Enter or Esc to return to drive selection menu." "Press Enter to Return"
    return
  fi

  clear
  echo "WipeStick: erasing - do not power off or remove the USB stick."
  echo "To stop, press Ctrl+C."
  echo
  # Ctrl+C reaches the engine, which records what it interrupted and exits.
  # Catch it here too, so this script survives to show the summary.
  trap 'echo "Stopping..."' INT
  # shellcheck disable=SC2086
  "$ENGINE" erase --confirm ERASE $selected
  local rc=$? logdir summary
  trap - INT
  logdir=$(cat /run/wipestick/log_dir 2>/dev/null)
  # One line per drive, then its notes, with the sanitize status on its own line.
  summary=$(awk -F'|' '{
      notes = $5; gsub(/ *(ATA|NVMe) sanitize status: */, "\n    Sanitize status: ", notes)
      sub(/^\n/, "", notes)
      if ($2 == "OK" || $2 == "DRY-RUN") printf "%-6s %-11s %-6s %-22s canaries %s\n", $1, $2, $6, $3, $4
      else printf "%-6s %s\n", $1, $2
      if (notes != "") printf "    %s\n", notes
    }' /run/wipestick/summary 2>/dev/null)
  local legend="Purge = firmware erase of the whole drive (strongest). Clear = every block overwritten once; spare areas inside an SSD are not reached."
  echo
  # If the engine suspended the machine to unfreeze a drive and no graphics
  # driver is loaded, the screen stays dark after resume. Power off on our own.
  if [[ -e /run/wipestick/suspended ]] && ! "$ENGINE" display >/dev/null 2>&1; then
    echo "The machine was suspended to unfreeze a drive, so the screen may be dark."
    echo "Powering off in 60 seconds. Press Enter to see the summary instead."
    if ! read -rt 60 _; then shutdown_quietly poweroff; fi
  else
    read -rp "Press Enter for the summary..." _
  fi
  local pc_head="" pc_btn="Press Enter to Continue"
  if needs_powercycle; then
    pc_head="
A drive is stuck in a firmware erase and must be POWERED OFF (not rebooted) to recover. Press Enter to power off now.
"
    pc_btn="Press Enter to Power Off"
  fi
  if [[ -e /run/wipestick/interrupted ]]; then
    msg "Process interrupted by user.
Drives marked INTERRUPTED or NOT STARTED must be treated as NOT erased. Run the erase again to finish them.
$pc_head
$summary
Log: $logdir" "$pc_btn"
  elif (( rc == 0 )); then
    msg "Operation successful.
All selected drives were erased and verified. All data and partition tables have been cleared.

$summary

$legend
Log: $logdir

Press Enter to continue." "Press Enter to Continue"
  else
    if needs_powercycle; then
      msg "One or more drives FAILED and must be treated as NOT erased.
$pc_head
$summary
Log: $logdir" "$pc_btn"
    else
      msg "One or more drives FAILED and must be treated as NOT erased.

$summary
Common fixes: set storage mode to AHCI; for self-encrypting drives, do a PSID revert; for frozen SATA drives, hot-plug the drive or try another port.
Log: $logdir

Press Enter to continue." "Press Enter to Continue"
    fi
  fi
  # Enter on the summary powers off when a drive needs it; Esc goes to the
  # (power-off-only) menu instead, e.g. to save diagnostics first.
  if needs_powercycle && (( MSG_RC == 0 )); then
    shutdown_quietly poweroff "$POWERCYCLE_NOTE"
  fi
  end_menu
}

[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }
# Pick the largest console font that still leaves at least 100x30 characters,
# so text stays readable on high-resolution panels once the graphics driver
# (Intel i915) sets native resolution.
pick_font() {
  local res w h font fw fh
  res=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null) || return 0
  w=${res%,*}; h=${res#*,}
  for font in 32x16 28x14 24x12 20x10; do
    fh=${font%x*}; fw=${font#*x}
    if (( w / fw >= 100 && h / fh >= 30 )) && [[ -f /usr/share/consolefonts/Uni2-TerminusBold$font.psf.gz ]]; then
      setfont "/usr/share/consolefonts/Uni2-TerminusBold$font.psf.gz" 2>/dev/null && return 0
    fi
  done
  return 0
}

setterm --blank 0 --powerdown 0 2>/dev/null
pick_font
dmesg -n 1 2>/dev/null          # keep kernel messages off the TUI
sleep 1; clear                  # let console font setup finish before drawing
while :; do main_loop; done
