#!/usr/bin/env bash
# wipestick-tui - type-to-confirm front end for wipestick.
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail
ENGINE=${WIPESTICK_ENGINE:-/usr/local/sbin/wipestick}
TITLE="wipestick"
export WIPESTICK_ACTIVE=1
export NEWT_COLORS='root=,red window=,black border=white,black textbox=white,black button=black,white title=white,black checkbox=white,black actcheckbox=black,white entry=white,black'

dims() { H=$(( $(tput lines) - 4 )); W=$(( $(tput cols) - 8 )); (( W > 100 )) && W=100; }

msg()   { dims; whiptail --title "$TITLE" --msgbox "$1" "$H" "$W"; }
yesno() { dims; whiptail --title "$TITLE" --yes-button "$2" --no-button "$3" --yesno "$1" "$H" "$W"; }

sysinfo() {
  printf '%s %s (S/N %s)' "$(dmidecode -s system-manufacturer 2>/dev/null | head -n1)" \
    "$(dmidecode -s system-product-name 2>/dev/null | head -n1)" \
    "$(dmidecode -s system-serial-number 2>/dev/null | head -n1)"
}

end_menu() {
  local choice
  dims
  choice=$(whiptail --title "$TITLE" --nocancel --menu "What next?" 15 64 5 \
    poweroff "Power off" \
    reboot   "Reboot (remove the USB first to boot the installer)" \
    again    "Start over" \
    diag     "Save diagnostics to the USB stick" \
    shell    "Drop to a root shell" 3>&1 1>&2 2>&3) || choice=again
  case $choice in
    poweroff) sync; systemctl poweroff 2>/dev/null || poweroff -f ;;
    reboot)   sync; systemctl reboot 2>/dev/null || reboot -f ;;
    shell)    clear; echo "Type 'exit' to return to wipestick."; bash -l ;;
    diag)     msg "Diagnostics saved to:
$("$ENGINE" diag 2>&1 | tail -n1)

Bring this file along when reporting a problem." ;;
  esac
}

main_loop() {
  local list warnings items=() dev class size model serial selected plan typed

  # Unit separator instead of tabs: bash collapses empty tab-separated fields.
  list=$("$ENGINE" list | tail -n +2 | tr '\t' '\037')
  warnings=$("$ENGINE" warnings)

  if [[ -z $list ]]; then
    msg "No internal drives were found.

$(sysinfo)

${warnings:-If this machine has a drive, check firmware setup: set the storage/SATA mode to AHCI (not RAID/RST/VMD) and make sure the drive is enabled.}"
    end_menu; return
  fi

  while IFS=$'\037' read -r dev class size model serial _; do
    items+=("$dev" "$(printf '%-9s %-8s %s  %s' "$size" "$class" "${model:-?}" "${serial:+S/N $serial}")" ON)
  done <<<"$list"

  dims
  selected=$(whiptail --title "$TITLE - select drives to ERASE" --separate-output \
    --checklist "$(sysinfo)
${warnings:+
WARNING: $warnings
}
Space toggles, Enter continues. The USB stick itself is never listed." \
    "$H" "$W" $(( H - 10 )) "${items[@]}" 3>&1 1>&2 2>&3) || { end_menu; return; }
  [[ -z $selected ]] && { msg "Nothing selected."; return; }

  # shellcheck disable=SC2086
  plan=$("$ENGINE" plan $selected 2>&1)
  dims
  typed=$(whiptail --title "$TITLE - CONFIRM" --inputbox "ALL DATA on these drives will be permanently destroyed.
Methods are tried in order until one is verified:

$plan

Type ERASE (capitals) to continue, or Cancel to go back." "$H" "$W" 3>&1 1>&2 2>&3) || return
  if [[ $typed != ERASE ]]; then msg "Confirmation did not match. Nothing was erased."; return; fi

  clear
  echo "wipestick: erasing - do not power off or remove the USB stick."
  echo
  # shellcheck disable=SC2086
  "$ENGINE" erase --confirm ERASE $selected
  local rc=$? logdir summary
  logdir=$(cat /run/wipestick/log_dir 2>/dev/null)
  summary=$(awk -F'|' '{printf "%-10s %-7s %-6s %-22s canaries %s\n%s", $1, $2, $6, $3, $4, ($5==""?"":"    "$5"\n")}' /run/wipestick/summary 2>/dev/null)
  local legend="Purge = firmware erase of the whole drive (strongest). Clear = every block overwritten once; spare areas inside an SSD are not reached."
  echo
  # If the engine suspended the machine to unfreeze a drive and no graphics
  # driver is loaded, the screen stays dark after resume. Power off on our own.
  if [[ -e /run/wipestick/suspended ]] && ! "$ENGINE" display >/dev/null 2>&1; then
    echo "The machine was suspended to unfreeze a drive, so the screen may be dark."
    echo "Powering off in 60 seconds. Press Enter to see the summary instead."
    if ! read -rt 60 _; then sync; systemctl poweroff 2>/dev/null || poweroff -f; fi
  else
    read -rp "Press Enter for the summary..." _
  fi
  if (( rc == 0 )); then
    msg "All selected drives erased and verified. Partition tables are cleared, so the machine is ready for an OS install.

$summary
$legend
Log: $logdir"
  else
    msg "One or more drives FAILED.

$summary
Common fixes: set storage mode to AHCI; for self-encrypting drives, do a PSID revert; for frozen SATA drives, hot-plug the drive or try another port.
Log: $logdir"
  fi
  end_menu
}

[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }
# Pick the largest console font that still leaves at least 100x30 characters,
# so text stays readable on high-resolution panels once the graphics driver
# (Intel i915) sets native resolution.
pick_font() {
  local res w h font fw fh
  res=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null) || return 0
  w=${res%,*}; h=${res#*,}
  for font in 32x16 28x14 24x12 20x10; do
    fh=${font%x*}; fw=${font#*x}
    if (( w / fw >= 100 && h / fh >= 30 )) && [[ -f /usr/share/consolefonts/Uni2-TerminusBold$font.psf.gz ]]; then
      setfont "/usr/share/consolefonts/Uni2-TerminusBold$font.psf.gz" 2>/dev/null && return 0
    fi
  done
  return 0
}

setterm --blank 0 --powerdown 0 2>/dev/null
pick_font
dmesg -n 1 2>/dev/null          # keep kernel messages off the TUI
sleep 1; clear                  # let console font setup finish before drawing
while :; do main_loop; done
